#. module: garese_pos_approval
#: model:ir.model.fields,help:garese_pos_approval.field_pos_config__gpa_price_requires_manager
#: model:ir.model.fields,help:garese_pos_approval.field_res_config_settings__pos_gpa_price_requires_manager
msgid ""
"A cashier needs a manager's password to change the price of a line on the "
"register."
msgstr ""
"Un caissier a besoin du mot de passe d'un responsable pour changer le prix "
"d'une ligne sur la caisse."

#. module: garese_pos_approval
#: model:ir.model.fields,help:garese_pos_approval.field_pos_config__gpa_cancel_requires_manager
#: model:ir.model.fields,help:garese_pos_approval.field_res_config_settings__pos_gpa_cancel_requires_manager
msgid ""
"A cashier needs a manager's password to delete an order line or an order."
msgstr ""
"Un caissier a besoin du mot de passe d'un responsable pour supprimer une "
"ligne de commande ou une commande."

#. module: garese_pos_approval
#: model:ir.model.fields,help:garese_pos_approval.field_pos_config__gpa_discount_requires_manager
#: model:ir.model.fields,help:garese_pos_approval.field_res_config_settings__pos_gpa_discount_requires_manager
msgid ""
"A cashier needs a manager's password to give a discount (line or order)."
msgstr ""
"Un caissier a besoin du mot de passe d'un responsable pour accorder une "
"remise (ligne ou commande)."

#. module: garese_pos_approval
#: model:ir.model.fields,help:garese_pos_approval.field_pos_config__gpa_refund_requires_manager
#: model:ir.model.fields,help:garese_pos_approval.field_res_config_settings__pos_gpa_refund_requires_manager
msgid "A cashier needs a manager's password to refund an order."
msgstr ""
"Un caissier a besoin du mot de passe d'un responsable pour rembourser une "
"commande."

